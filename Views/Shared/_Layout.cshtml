<!DOCTYPE html>
<html lang="bg">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EasyTicket Pro</title>

    <!-- Bootstrap 5 & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100 text-light"
      style="background: linear-gradient(rgba(0, 0, 0, 0.85), rgba(0, 0, 0, 0.85)), url('/images/BackGround.jpg') fixed center / cover no-repeat;">

    <!-- ========================================== -->
    <!-- LAYER 1: HEADER & GLOBAL NAVIGATION        -->
    <!-- ========================================== -->
    <header class="sticky-top shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark py-3">
            <div class="container">
                
                <!-- 1. LOGO -->
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-warning fs-4 me-4"
                   asp-controller="Home" asp-action="Index">
                    <i class="bi bi-ticket-perforated-fill text-warning fs-2"></i>
                    <span>EasyTicket <span class="badge bg-warning text-dark fs-6 align-middle ms-1">PRO</span></span>
                </a>

                <!-- Mobile Toggle Button -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- NAVBAR CONTENT -->
                <div class="collapse navbar-collapse" id="mainNavbar">
                    
                    <!-- 2. NAVIGATION LINKS -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 fw-semibold">
                        <li class="nav-item">
                            <a class="nav-link active" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="bi bi-music-note-beats me-1"></i> Concerts
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="bi bi-trophy me-1"></i> Sports
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="bi bi-masks-theater me-1"></i> Theater
                            </a>
                        </li>
                    </ul>

                    <!-- 3. SEARCH BAR -->
                    <form class="d-flex me-lg-4 mb-3 mb-lg-0" role="search">
                        <div class="input-group">
                            <input class="form-control border-end-0 bg-dark text-light placeholder-glow" type="search"
                                   placeholder="Търси събитие, изпълнител..." aria-label="Search"
                                   style="border-color: #495057;">
                            <button class="btn btn-outline-warning border-start-0" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>

                    <!-- 4. USER ACTIONS -->
                    <div class="d-flex align-items-center gap-2">
                        <a href="#" class="btn btn-outline-light rounded-pill px-3">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign in
                        </a>
                        <a href="#" class="btn btn-warning rounded-pill px-3 fw-bold">
                            <i class="bi bi-person-plus me-1"></i> Register
                        </a>
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <!-- ========================================== -->
    <!-- DYNAMIC BODY CONTENT (Layer 2 & Layer 3)   -->
    <!-- ========================================== -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- ========================================== -->
    <!-- LAYER 1: FOOTER                            -->
    <!-- ========================================== -->
    <footer class="bg-dark text-light border-top border-secondary py-4 mt-auto">
        <div class="container text-center text-md-start">
            <div class="row gy-3">
                <div class="col-md-5">
                    <h5 class="text-warning fw-bold">🎟️ EasyTicket Pro</h5>
                    <p class="small text-secondary mb-0">A modern platform for fast and secure ticket purchasing for
                        your favorite events.</p>
                    </div>
                    <div class="col-md-3">
                        <h6 class="text-uppercase fw-bold text-light">Quick Links</h6>
                        <ul class="list-unstyled mb-0 small">
                            <li><a href="#" class="text-secondary text-decoration-none">Upcoming Events</a></li>
                            <li><a href="#" class="text-secondary text-decoration-none">Organize Event</a></li>
                        </ul>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <p class="small text-secondary mb-0">&copy; 2026 <strong>EasyTicket Pro</strong>. All rights
                            reserved.</p>
                        </div>
                    </div>
                </div>
            </footer>

            <!-- Scripts -->
            <script src="~/lib/jquery/dist/jquery.min.js"></script>
            <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
            @await RenderSectionAsync("Scripts", required: false)
        </body>

    </html>