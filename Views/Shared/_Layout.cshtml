<!DOCTYPE html>
<html lang="bg">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EasyTicket Pro</title>

    @* Bootstrap 5 & Icons *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100 text-light"
      style="background: linear-gradient(rgba(0, 0, 0, 0.85), rgba(0, 0, 0, 0.85)), url('/Assets/Photos/BackGround.jpg') fixed center / cover no-repeat;">

    @* NAVIGATION BAR *@
    <header class="sticky-top shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark py-3">
            <div class="container">
                
                @* Logo *@
                <a href="/home" class="navbar-brand d-flex align-items-center gap-2 fw-bold text-warning fs-4 me-4">
                    <i class="bi bi-ticket-perforated-fill text-warning fs-2"></i>
                    <span>EasyTicket <span class="badge bg-warning text-dark fs-6 align-middle ms-1">PRO</span></span>
                </a>

                @* Mobile Toggle Button *@
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                @* NAVBAR CONTENT *@
                <div class="collapse navbar-collapse" id="mainNavbar">
                    
                    @* NAVIGATION LINKS *@
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 fw-semibold">
                        <li class="nav-item">
                            <a class="nav-link active" href="/home">
                                <i class="bi bi-house-door me-1"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/concerts">
                                <i class="bi bi-music-note-beats me-1"></i> Concerts
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/sports">
                                <i class="bi bi-trophy me-1"></i> Sports
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/theaters">
                                <i class="bi bi-masks-theater me-1"></i> Theater
                            </a>
                        </li>
                    </ul>

                    @* USER ACTIONS *@
                    <div class="d-flex align-items-center gap-2" id="guestActions">
                        <!-- Sign In Button triggers Modal -->
                        <button type="button" class="btn btn-outline-light rounded-pill px-3" data-bs-toggle="modal"
                                data-bs-target="#authModal">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                        </button>
    
                        <!-- Register Button triggers Modal -->
                        <button type="button" class="btn btn-warning rounded-pill px-3 fw-bold" data-bs-toggle="modal"
                                data-bs-target="#authModal">
                            <i class="bi bi-person-plus me-1"></i> Register
                        </button>
                    </div>

                </div>
            </div>
        </nav>
    </header>

    @* DYNAMIC BODY CONTENT *@
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    @* FOOTER BAR *@
    
    <footer class="bg-dark text-light border-top border-secondary py-4 mt-auto">
        <div class="container text-center text-md-start">
            <div class="row gy-3">
                <div class="col-md-5">
                    <h5 class="text-warning fw-bold">🎟️ EasyTicket Pro</h5>
                    <p class="small text-secondary mb-0">A modern platform for fast and secure ticket purchasing for
                        your favorite events.</p>
                    </div>
                    <div class="col-md-3">
                        <h6 class="text-uppercase fw-bold text-light">Quick Links</h6>
                        <ul class="list-unstyled mb-0 small">
                            <li><a href="#" class="text-secondary text-decoration-none">Upcoming Events</a></li>
                            <li><a href="#" class="text-secondary text-decoration-none">Organize Event</a></li>
                        </ul>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <p class="small text-secondary mb-0">&copy; 2026 <strong>EasyTicket Pro</strong>. All rights
                            reserved.</p>
                        </div>
                    </div>
                </div>
            </footer>

            <!-- Scripts -->
            <script src="~/lib/jquery/dist/jquery.min.js"></script>
            <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
            @await RenderSectionAsync("Scripts", required: false)




            <!-- LOGIN / REGISTER MODAL -->
            <div class="modal fade" id="authModal" tabindex="-1" aria-labelledby="authModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content bg-dark text-light border border-secondary shadow-lg rounded-4"
                         style="background: rgba(15, 15, 15, 0.85) !important; backdrop-filter: blur(20px);">
                        
                        <!-- Modal Header -->
                        <div class="modal-header border-bottom border-secondary">
                            <h5 class="modal-title text-warning fw-bold" id="authModalLabel">
                                <i class="bi bi-ticket-perforated-fill me-2"></i>Access EasyTicket Pro
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                        </div>

                        <!-- Modal Body (Forms) -->
                        <div class="modal-body p-4">
                            <!-- Tabs за превключване между Login и Register -->
                            <ul class="nav nav-pills nav-fill mb-4 bg-black bg-opacity-50 p-1 rounded-pill border border-secondary"
                                id="pills-tab" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active rounded-pill text-warning fw-semibold" id="pills-login-tab"
                                            data-bs-toggle="pill" data-bs-target="#pills-login" type="button" role="tab">Sign
                                        In</button>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link rounded-pill text-light fw-semibold" id="pills-register-tab"
                                                data-bs-toggle="pill" data-bs-target="#pills-register" type="button"
                                                role="tab">Register</button>
                                    </li>
                                </ul>

                                <div class="tab-content" id="pills-tabContent">
                                    <!-- LOGIN FORM -->
                                    <div class="tab-pane fade show active" id="pills-login" role="tabpanel">
                                        <form>
                                            <div class="mb-3">
                                                <label class="form-label text-muted small">Email Address</label>
                                                <input type="email"
                                                       class="form-control bg-black text-light border-secondary rounded-pill px-3"
                                                       placeholder="name@example.com">
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label text-muted small">Password</label>
                                                <input type="password"
                                                       class="form-control bg-black text-light border-secondary rounded-pill px-3"
                                                       placeholder="••••••••">
                                            </div>
                                            <button type="submit"
                                                    class="btn btn-warning w-100 fw-bold py-2 rounded-pill text-dark shadow-lg mt-3">
                                                Sign In
                                            </button>
                                        </form>
                                    </div>

                                    <!-- REGISTER FORM -->
                                    <div class="tab-pane fade" id="pills-register" role="tabpanel">
                                        <form>
                                            <div class="row">
                                                <div class="col-6 mb-3">
                                                    <label class="form-label text-muted small">First Name</label>
                                                    <input type="text"
                                                           class="form-control bg-black text-light border-secondary rounded-pill px-3"
                                                           placeholder="Ivan">
                                                </div>
                                                <div class="col-6 mb-3">
                                                    <label class="form-label text-muted small">Last Name</label>
                                                    <input type="text"
                                                           class="form-control bg-black text-light border-secondary rounded-pill px-3"
                                                           placeholder="Ivanov">
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label text-muted small">Email Address</label>
                                                <input type="email"
                                                       class="form-control bg-black text-light border-secondary rounded-pill px-3"
                                                       placeholder="name@example.com">
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label text-muted small">Password</label>
                                                <input type="password"
                                                       class="form-control bg-black text-light border-secondary rounded-pill px-3"
                                                       placeholder="••••••••">
                                            </div>
                                            <button type="submit"
                                                    class="btn btn-warning w-100 fw-bold py-2 rounded-pill text-dark shadow-lg mt-2">
                                                Create Account
                                            </button>
                                        </form>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

            </body>

        </html>