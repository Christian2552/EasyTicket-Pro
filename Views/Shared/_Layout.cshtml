@model EasyTicket_Pro.Models.User

<!DOCTYPE html>
<html lang="bg">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EasyTicket Pro</title>

    @* Bootstrap 5 & Icons *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100 text-light"
      style="background: linear-gradient(rgba(0, 0, 0, 0.85), rgba(0, 0, 0, 0.85)), url('/Assets/Photos/BackGround.jpg') fixed center / cover no-repeat;">

    @* NAVIGATION BAR *@
    <header class="sticky-top shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark py-3">
            <div class="container">
                
                @* Logo *@
                <a href="/home" class="navbar-brand d-flex align-items-center gap-2 fw-bold text-warning fs-4 me-4">
                    <i class="bi bi-ticket-perforated-fill text-warning fs-2"></i>
                    <span>EasyTicket <span class="badge bg-warning text-dark fs-6 align-middle ms-1">PRO</span></span>
                </a>

                @* Mobile Toggle Button *@
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                @* NAVBAR CONTENT *@
                <div class="collapse navbar-collapse" id="mainNavbar">
                    
                    @* NAVIGATION LINKS *@
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 fw-semibold">
                        <li class="nav-item">
                            <a class="nav-link active" href="/home">
                                <i class="bi bi-house-door text-warning me-1"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/concerts">
                                <i class="bi bi-music-note-beamed text-warning me-2"></i> Concerts
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/sports">
                                <i class="bi bi-trophy-fill text-warning me-2"></i> Sports
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/theaters">
                                <i class="bi bi-mask text-warning me-2"></i> Theater
                            </a>
                        </li>
                    </ul>

                    @* USER ACTIONS *@
                    <div class="d-flex align-items-center gap-2" id="userActions">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <a asp-controller="Account" asp-action="ProfilePage"
                               class="btn btn-outline-warning rounded-pill px-3">
                                <i class="bi bi-person-circle me-1"><span> Profile</span></i>
                            </a>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-danger rounded-pill px-3 fw-bold">
                                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                                </button>
                            </form>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-light rounded-pill px-3" data-bs-toggle="modal"
                                    data-bs-target="#authModal">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                            </button>
                            <button type="button" class="btn btn-warning rounded-pill px-3 fw-bold" data-bs-toggle="modal"
                                    data-bs-target="#authModal">
                                <i class="bi bi-person-plus me-1"></i> Register
                            </button>
                        }
                    </div>

                </div>
            </div>
        </nav>
    </header>

    @* DYNAMIC BODY CONTENT *@
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    @* FOOTER BAR *@
    <footer class="bg-dark text-light border-top border-secondary py-4 mt-auto">
        <div class="container text-center text-md-start">
            <div class="row gy-3">
                <div class="col-md-5">
                    <h5 class="text-warning fw-bold">🎟️ EasyTicket Pro</h5>
                    <p class="small text-secondary mb-0">A modern platform for fast and secure ticket purchasing for
                        your favorite events.</p>
                    </div>
                    <div class="col-md-3">
                        <h6 class="text-uppercase fw-bold  text-warning">Quick Links</h6>
                        <ul class="list-unstyled mb-0 small">
                            <li><a href="#" class="text-secondary text-decoration-none">Upcoming Events</a></li>
                            <li><a href="#" class="text-secondary text-decoration-none">Organize Event</a></li>
                        </ul>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <p class="small text-secondary mb-0">&copy; 2026 <strong>EasyTicket Pro</strong>. All rights
                            reserved.</p>
                        </div>
                    </div>
                </div>
            </footer>

            @* AUTHENTICATION MODAL *@
            <div class="modal fade" id="authModal" tabindex="-1" aria-labelledby="authModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content bg-dark text-light border border-secondary shadow-lg rounded-4"
                         style="background: rgba(15, 15, 15, 0.85) !important; backdrop-filter: blur(20px);">
        
                        @* MODAL HEADER *@
                        <div class="modal-header border-bottom border-secondary">
                            <h5 class="modal-title text-warning fw-bold" id="authModalLabel">
                                <i class="bi bi-ticket-perforated-fill me-2"></i>Access EasyTicket Pro
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                        </div>

                        @* MODAL BODY *@
                        <div class="modal-body p-4">
                            <ul class="nav nav-pills nav-fill mb-4 bg-black bg-opacity-50 p-1 rounded-pill border border-secondary"
                                id="pills-tab" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active rounded-pill text-warning fw-semibold" id="pills-login-tab"
                                            data-bs-toggle="pill" data-bs-target="#pills-login" type="button" role="tab">Sign
                                        In</button>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link rounded-pill text-light fw-semibold" id="pills-register-tab"
                                                data-bs-toggle="pill" data-bs-target="#pills-register" type="button"
                                                role="tab">Register</button>
                                    </li>
                                </ul>

                                <div class="tab-content" id="pills-tabContent">
                                    @* LOGIN FORM *@
                                    <div class="tab-pane fade show active" id="pills-login" role="tabpanel">
                                        <form asp-controller="Account" asp-action="Login" method="post">
                                            @if (TempData["LoginError"] != null)
                                            {
                                                <div class="alert alert-danger small py-2 mb-3">
                                                    @TempData["LoginError"]
                                                </div>
                                            }
                                            <div class="mb-3">
                                                <label class="form-label text-warning small fw-semibold">Email Address</label>
                                                <input type="email" name="email"
                                                       class="form-control bg-dark text-light border-secondary rounded-pill px-3 py-2"
                                                       placeholder="name@example.com" required>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label text-warning small fw-semibold">Password</label>
                                                <input type="password" name="password"
                                                       class="form-control bg-dark text-light border-secondary rounded-pill px-3 py-2"
                                                       placeholder="••••••••" required>
                                            </div>
                                            <button type="submit"
                                                    class="btn btn-warning w-100 fw-bold py-2 rounded-pill text-dark shadow-lg mt-3">Sign
                                                In</button>
                                            </form>
                                        </div>

                                        @* REGISTER FORM *@
                                        <div class="tab-pane fade" id="pills-register" role="tabpanel">
                                            <form asp-controller="Account" asp-action="Register" method="post">
                                                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                                                <div class="row">
                                                    <div class="col-6 mb-3">
                                                        <label class="form-label text-warning small fw-semibold">First Name</label>
                                                        <input type="text" asp-for="FirstName"
                                                               class="form-control bg-dark text-light border-secondary rounded-pill px-3 py-2"
                                                               placeholder="Ivan">
                                                        <span asp-validation-for="FirstName"
                                                              class="text-danger small mt-1 d-block"></span>
                                                    </div>
                                                    <div class="col-6 mb-3">
                                                        <label class="form-label text-warning small fw-semibold">Last Name</label>
                                                        <input type="text" asp-for="LastName"
                                                               class="form-control bg-dark text-light border-secondary rounded-pill px-3 py-2"
                                                               placeholder="Ivanov">
                                                        <span asp-validation-for="LastName"
                                                              class="text-danger small mt-1 d-block"></span>
                                                    </div>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label text-warning small fw-semibold">Email Address</label>
                                                    <input type="email" asp-for="Email"
                                                           class="form-control bg-dark text-light border-secondary rounded-pill px-3 py-2"
                                                           placeholder="name@example.com">
                                                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label text-warning small fw-semibold">Password</label>
                                                    <input type="password" asp-for="Password"
                                                           class="form-control bg-dark text-light border-secondary rounded-pill px-3 py-2"
                                                           placeholder="••••••••">
                                                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                                                </div>
                                                <button type="submit"
                                                        class="btn btn-warning w-100 fw-bold py-2 rounded-pill text-dark shadow-lg mt-2">Create
                                                    Account</button>
                                                </form>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Scripts (Slagash gi tochno pridi </body>) -->
                        <script src="~/lib/jquery/dist/jquery.min.js"></script>
                        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
                        <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
                        <script
                        src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

                        @await RenderSectionAsync("Scripts", required: false)

                    </body>

                </html>