@model EasyTicket_Pro.Models.User

@{
    ViewData["Title"] = "";
}

<!-- HERO SECTION: Main Banner with Background Image -->

<section
    class="py-5 mb-5 text-center text-lg-start rounded-4 shadow-lg border border-warning position-relative overflow-hidden"
    style="background: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.5)), url('/A/Photos/BackGround.jpg') fixed center / cover no-repeat !important;">
    
    <div class="container py-5 position-relative z-1 mb-5" style="min-height: 44vh;">
        <div class="row align-items-center gy-4">
            <div class="col-lg-7">
                <span class="badge bg-warning text-dark px-3 py-2 fs-6 rounded-pill mb-3 fw-bold shadow-sm">
                    Premier Ticketing Platform
                </span>
                <h1 class="display-4 fw-extrabold text-white mb-3">
                    Your Pass to the <span class="text-warning">Best Events</span>!
                </h1>
                <p class="lead text-light opacity-75 mb-4">
                    Book tickets for your favorite concerts, sports games, and theater shows in just a few clicks.
                    Secure, fast, and hassle-free.
                </p>
            
                <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start">
                    <div class="dropdown d-inline-block">
                        <button class="btn btn-warning btn-lg px-4 fw-bold rounded-pill shadow-sm dropdown-toggle"
                                type="button" id="exploreDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-ticket-perforated-fill me-2"></i> Explore Events
                        </button>

                        <ul class="dropdown-menu dropdown-menu-dark bg-dark border-secondary shadow-lg rounded-4 p-2 mt-2"
                            aria-labelledby="exploreDropdown"
                            style="background: rgba(15, 15, 15, 0.95) !important; backdrop-filter: blur(20px);">
    
                            <li>
                                <a class="dropdown-item text-light rounded-pill px-3 py-2 my-1" href="/concerts">
                                    <i class="bi bi-music-note-beamed text-warning me-2"></i> Concerts
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item text-light rounded-pill px-3 py-2 my-1" href="/sports">
                                    <i class="bi bi-trophy-fill text-warning me-2"></i> Sports
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item text-light rounded-pill px-3 py-2 my-1" href="/theaters">
                                    <i class="bi bi-mask text-warning me-2"></i> Theater
                                </a>
                            </li>
                        </ul>
                    </div>
                
                    <a href="https://www.youtube.com/watch?v=GBIIQ0kP15E" target="_blank"
                       class="btn btn-outline-warning btn-lg px-4 rounded-pill">
                        <i class="bi bi-play-circle me-2"></i> How It Works
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ADVANTAGES / Why Choose EasyTicket Pro -->
<section class="py-4 mb-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-warning mb-2">Why Choose EasyTicket Pro?</h2>
        <p class="text-light opacity-75">Everything you need for your next unforgettable experience.</p>
    </div>

    <div class="row g-4 text-center">
        <div class="col-md-4">
            <div class="card h-100 bg-dark bg-opacity-75 text-white border border-secondary p-4 rounded-4 shadow">
                <div class="mb-3 text-warning">
                    <i class="bi bi-lightning-charge-fill fs-1"></i>
                </div>
                <h4 class="fw-bold mb-2 text-warning">Instant Booking</h4>
                <p class="text-light opacity-75 small">Purchase your tickets in under 60 seconds with no complex steps
                    or long queues.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 bg-dark bg-opacity-75 text-white border border-secondary p-4 rounded-4 shadow">
                    <div class="mb-3 text-warning">
                        <i class="bi bi-shield-lock-fill fs-1"></i>
                    </div>
                    <h4 class="fw-bold mb-2 text-warning">100% Secure Payments</h4>
                    <p class="text-light opacity-75 small">We use cutting-edge encryption technology to keep your data and
                        transactions safe.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 bg-dark bg-opacity-75 text-white border border-secondary p-4 rounded-4 shadow">
                        <div class="mb-3 text-warning">
                            <i class="bi bi-phone-fill fs-1"></i>
                        </div>
                        <h4 class="fw-bold mb-2 text-warning">All in Your Phone</h4>
                        <p class="text-light opacity-75 small">No printing required – simply scan your digital QR code right at
                            the venue entrance.</p>
                        </div>
                    </div>
                </div>
            </section>