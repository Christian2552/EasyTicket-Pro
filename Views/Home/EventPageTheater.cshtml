@{
    ViewData["Title"] = "Theater Event - EasyTicket Pro";
}

<div class="container py-5">
    <!-- Breadcrumb / Back button -->
    <div class="mb-4">
        <a href="/home" class="text-warning text-decoration-none d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Back to Home
        </a>
    </div>

    <div class="row g-5">
        <!-- LEFT COLUMN: Theater Banner & Quick Info -->
        <div class="col-lg-6">
            <div class="card bg-dark border-secondary shadow-lg overflow-hidden rounded-4">
                <div class="position-relative">
                    <!-- Theater Placeholder Icon -->
                    <div class="bg-secondary text-dark d-flex align-items-center justify-content-center"
                         style="height: 350px;">
                        <i class="bi bi-masks-theater display-1 text-warning"></i>
                    </div>
                    <span
                        class="badge bg-warning text-dark position-absolute top-0 start-0 m-3 px-3 py-2 fw-bold rounded-pill">
                        Theater Play
                    </span>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center text-muted mb-3">
                        <span><i class="bi bi-calendar3 text-warning me-1"></i> 10 August 2026</span>
                        <span><i class="bi bi-clock text-warning me-1"></i> 19:00h</span>
                    </div>
                    <p class="text-light mb-0"><i class="bi bi-geo-alt-fill text-warning me-1"></i> National Theater
                        "Ivan Vazov", Sofia</p>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN: Title, Description & Booking -->
            <div class="col-lg-6 d-flex flex-column justify-content-between">
                <div>
                    <h1 class="display-5 fw-bold text-light mb-3">Classic Masterpiece: The Phantom Stage</h1>
                    <p class="text-muted fs-5 mb-4">
                        Immerse yourself in an evening of profound emotion, brilliant acting, and timeless drama. A
                        magnificent theatrical production featuring acclaimed actors and stunning stage design.
                    </p>

                    <div class="p-4 bg-black bg-opacity-50 border border-secondary rounded-4 mb-4">
                        <h4 class="text-warning fw-bold mb-3">Seating & Pricing</h4>
                        <div class="d-flex justify-content-between align-items-center mb-2 text-light">
                            <span>Balcony / 3rd Tier</span>
                            <span class="fw-bold text-warning fs-4">$20.00</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2 text-light">
                            <span>Parterre (Standard)</span>
                            <span class="fw-bold text-warning fs-4">$40.00</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center text-light">
                            <span>Loge / Box Seats</span>
                            <span class="fw-bold text-warning fs-4">$90.00</span>
                        </div>
                    </div>
                </div>

                <!-- Action Button -->
                <div class="d-grid gap-2">
                    <button class="btn btn-warning btn-lg fw-bold py-3 rounded-pill shadow-lg text-dark">
                        <i class="bi bi-ticket-perforated-fill me-2"></i> Reserve Theater Seats
                    </button>
                </div>
            </div>
        </div>
    </div>