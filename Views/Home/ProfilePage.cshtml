@model EasyTicket_Pro.Models.User

@{
    ViewData["Title"] = "User Dashboard";
}

<div class="container py-5">
    <div class="row g-4">
        
        @* Left Block: User Profile Information*@
        <div class="col-lg-4">
            <div class="card bg-dark text-light border border-secondary shadow-lg rounded-4 p-4 h-100"
                 style="background: rgba(15, 15, 15, 0.85) !important; backdrop-filter: blur(20px);">
                 
                <div class="text-center mb-4">
                    <i class="bi bi-person-circle text-warning display-1"></i>
                    <h3 class="text-warning fw-bold mt-2">@Model.FirstName @Model.LastName</h3>
                    <p class="text-secondary small">@Model.Email</p>
                </div>

                <hr class="border-secondary">

                <div class="mb-3">
                    <label class="form-label text-warning small fw-semibold">First Name</label>
                    <input type="text" class="form-control bg-dark text-light border-secondary rounded-pill px-3 py-2"
                           value="@Model.FirstName" readonly>
                </div>

                <div class="mb-3">
                    <label class="form-label text-warning small fw-semibold">Last Name</label>
                    <input type="text" class="form-control bg-dark text-light border-secondary rounded-pill px-3 py-2"
                           value="@Model.LastName" readonly>
                </div>

                <div class="mb-3">
                    <label class="form-label text-warning small fw-semibold">Email Address</label>
                    <input type="email" class="form-control bg-dark text-light border-secondary rounded-pill px-3 py-2"
                           value="@Model.Email" readonly>
                </div>

                <div class="mt-auto pt-3 d-flex justify-content-between align-items-center">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light rounded-pill px-3 btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Home
                    </a>

                    @* Delete Profile Form *@
                    <form asp-controller="Events" asp-action="DeleteEvent" method="post"
                          onsubmit="return confirm('Are you sure you want to delete your profile?');">
                        <button type="submit" class="btn btn-outline-danger rounded-pill px-3 btn-sm fw-bold">
                            <i class="bi bi-trash me-1"></i> Delete Profile
                        </button>
                    </form>
                </div>

            </div>
        </div>

        @* Right Block: Bought Tickets History *@
        <div class="col-lg-8">
            <div class="card bg-dark text-light border border-secondary shadow-lg rounded-4 p-4 h-100"
                 style="background: rgba(15, 15, 15, 0.85) !important; backdrop-filter: blur(20px);">
 
                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-ticket-perforated-fill text-warning fs-3 me-2"></i>
                    <h4 class="text-warning fw-bold mb-0">My Bought Tickets History</h4>
                </div>
                <p class="text-secondary small mb-4">Here is the history of all the tickets and events you have booked
                    so far.</p>

                    @if (ViewBag.MyTickets != null && ((List<EasyTicket_Pro.Models.Ticket>)ViewBag.MyTickets).Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-dark table-hover align-middle mb-0">
                                <thead>
                                    <tr class="text-warning small">
                                        <th>Event Title</th>
                                        <th>Purchase Date</th>
                                        <th>Quantity</th>
                                        <th>Total Price</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ticket in (List<EasyTicket_Pro.Models.Ticket>)ViewBag.MyTickets)
                                    {
                                        <tr>
                                            <td>
                                                <span class="fw-bold text-light">
                                                    <i class="bi bi-bookmark-star text-warning me-1"></i>
                                                    @(ticket.Event != null ? ticket.Event.Title : "Event #" + ticket.EventId)
                                                </span>
                                            </td>
                                            <td class="text-secondary small">@ticket.PurchasedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td><span class="badge bg-secondary text-light">@ticket.Quantity</span></td>
                                            <td class="text-warning fw-bold">$@ticket.TotalPrice.ToString("0.00")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-secondary my-auto">
                            <i class="bi bi-emoji-frown fs-1 d-block mb-2 text-warning"></i>
                            You haven't purchased any tickets yet. Explore events and book your first one!
                        </div>
                    }

                </div>
            </div>
        </div>