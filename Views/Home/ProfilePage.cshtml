@model EasyTicket_Pro.Models.User

@{
    ViewData["Title"] = "User Dashboard";
}

<div class="container py-5">
    <div class="row g-4">
        
        <!-- LYАВА КОЛОНА: Профил и изтриване -->
        <div class="col-lg-5">
            <div class="card bg-dark text-light border border-secondary shadow-lg rounded-4 p-4 h-100"
                 style="background: rgba(15, 15, 15, 0.85) !important; backdrop-filter: blur(20px);">
                 
                <div class="text-center mb-4">
                    <i class="bi bi-person-circle text-warning display-1"></i>
                    <h3 class="text-warning fw-bold mt-2">@Model.FirstName @Model.LastName</h3>
                    <p class="text-secondary small">@Model.Email</p>
                </div>

                <hr class="border-secondary">

                <div class="mb-3">
                    <label class="form-label text-warning small fw-semibold">First Name</label>
                    <input type="text" class="form-control bg-dark text-light border-secondary rounded-pill px-3 py-2"
                           value="@Model.FirstName" readonly>
                </div>

                <div class="mb-3">
                    <label class="form-label text-warning small fw-semibold">Last Name</label>
                    <input type="text" class="form-control bg-dark text-light border-secondary rounded-pill px-3 py-2"
                           value="@Model.LastName" readonly>
                </div>

                <div class="mb-3">
                    <label class="form-label text-warning small fw-semibold">Email Address</label>
                    <input type="email" class="form-control bg-dark text-light border-secondary rounded-pill px-3 py-2"
                           value="@Model.Email" readonly>
                </div>

                <div class="mt-auto pt-3 d-flex justify-content-between align-items-center">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light rounded-pill px-3 btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Home
                    </a>

                    <!-- Бутон за изтриване на профила -->
                    <form asp-controller="Account" asp-action="DeleteAccount" method="post"
                          onsubmit="return confirm('Are you sure you want to delete your account?');">
                        <button type="submit" class="btn btn-outline-danger rounded-pill px-3 btn-sm fw-bold">
                            <i class="bi bi-trash me-1"></i> Delete Profile
                        </button>
                    </form>
                </div>

            </div>
        </div>

        <!-- ДЯСНА КОЛОНА: Блок за създаване на събития -->
        <div class="col-lg-7">
            <div class="card bg-dark text-light border border-secondary shadow-lg rounded-4 p-4 h-100"
                 style="background: rgba(15, 15, 15, 0.85) !important; backdrop-filter: blur(20px);">
                 
                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-plus-circle-fill text-warning fs-3 me-2"></i>
                    <h4 class="text-warning fw-bold mb-0">Create New Event</h4>
                </div>
                <p class="text-secondary small mb-4">Publish a concert, sports game, or theater show for users to book
                    tickets.</p>

                    <form asp-controller="Account" asp-action="CreateEvent" method="post">
                    
                        <div class="mb-3">
                            <label class="form-label text-warning small fw-semibold">Event Title</label>
                            <input type="text" name="Title"
                                   class="form-control bg-dark text-light border-secondary rounded-pill px-3 py-2"
                                   placeholder="Rock Concert 2026" required>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-warning small fw-semibold">Category</label>
                                <select name="Category"
                                        class="form-control bg-dark text-light border-secondary rounded-pill px-3 py-2"
                                        required>
                                    <option value="Concerts">Concerts</option>
                                    <option value="Sports">Sports</option>
                                    <option value="Theater">Theater</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-warning small fw-semibold">Ticket Price ($)</label>
                                <input type="number" step="0.01" name="Price"
                                       class="form-control bg-dark text-light border-secondary rounded-pill px-3 py-2"
                                       placeholder="45.00" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-warning small fw-semibold">Event Date & Time</label>
                            <input type="datetime-local" name="Date"
                                   class="form-control bg-dark text-light border-secondary rounded-pill px-3 py-2" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-warning small fw-semibold">Description</label>
                            <textarea name="Description"
                                      class="form-control bg-dark text-light border-secondary rounded-3 px-3 py-2" rows="3"
                                      placeholder="Write details about the event..."></textarea>
                        </div>

                        <button type="submit"
                                class="btn btn-warning w-100 fw-bold py-2 rounded-pill text-dark shadow-lg mt-2">
                            <i class="bi bi-calendar-check me-1"></i> Publish Event
                        </button>
                    </form>

                </div>
            </div>

            <!-- NOVA SEKCIYA: Istoriq na zakupenite bileti -->
            <div class="col-12 mt-4">
                <div class="card bg-dark text-light border border-secondary shadow-lg rounded-4 p-4"
                     style="background: rgba(15, 15, 15, 0.85) !important; backdrop-filter: blur(20px);">
         
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-ticket-perforated-fill text-warning fs-3 me-2"></i>
                        <h4 class="text-warning fw-bold mb-0">My Bought Tickets History</h4>
                    </div>
                    <p class="text-secondary small mb-4">Here is the history of all the tickets and events you have booked
                        so far.</p>

                        @* @if (ViewBag.MyTickets != null && ((List<EasyTicket_Pro.Models.Ticket>)ViewBag.MyTickets).Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-dark table-hover align-middle mb-0">
                                    <thead>
                                        <tr class="text-warning small">
                                            <th>Event ID</th>
                                            <th>Purchase Date</th>
                                            <th>Quantity</th>
                                            <th>Total Price</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var ticket in (List<EasyTicket_Pro.Models.Ticket>)ViewBag.MyTickets)
                                        {
                                            <tr>
                                                <td><span class="badge bg-warning text-dark fw-bold">#@ticket.EventId</span></td>
                                                <td>@ticket.PurchaseDate.ToString("dd.MM.yyyy HH:mm")</td>
                                                <td>@ticket.Quantity</td>
                                                <td class="text-warning fw-bold">$@ticket.TotalPrice</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4 text-secondary">
                                <i class="bi bi-emoji-frown fs-2 d-block mb-2"></i>
                                You haven't purchased any tickets yet. Explore events and book your first one!
                            </div>
                        } *@
                    </div>
                </div>

            </div>
        </div>